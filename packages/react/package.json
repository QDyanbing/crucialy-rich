{
  "name": "@crucialy-rich/react",
  "version": "0.1.0",
  "description": "React bindings for the crucialy-rich editor kernel.",
  "keywords": [
    "rich-text",
    "editor",
    "wysiwyg",
    "react",
    "crucialy-rich"
  ],
  "homepage": "https://github.com/QDyanbing/crucialy-rich/tree/master/packages/react#readme",
  "bugs": {
    "url": "https://github.com/QDyanbing/crucialy-rich/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QDyanbing/crucialy-rich.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "QDyanbing",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --tsconfig tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false"
  },
  "dependencies": {
    "@crucialy-rich/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
